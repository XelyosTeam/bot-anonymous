{
    "name": "bot-anonymous",
    "version": "10.0.0",
    "description": "Self-hosted Discord bot for anonymous roleplay messages",
    "private": true,
    "main": "app.js",
    "engines": {
        "node": ">=22.13"
    },
    "scripts": {
        "start": "node app.js",
        "dev": "nodemon app.js",
        "test": "node --test",
        "lint": "prettier --check .",
        "format": "prettier --write .",
        "commands:deploy": "node extra/commands-deploy.js",
        "commands:purge": "node extra/commands-purge.js"
    },
    "author": "Aros <aros@xelyos.fr> - Team Xelyos (https://xelyos.fr/)",
    "license": "MIT",
    "dependencies": {
        "discord.js": "14.28.1"
    },
    "devDependencies": {
        "discord-api-types": "0.38.53",
        "nodemon": "3.1.14",
        "prettier": "3.9.6"
    }
}
