###########################################################
# Required
###########################################################

# Bot token: https://discord.com/developers/applications > your application > Bot > Reset Token
DISCORD_BOT_TOKEN=

# ID of the (private, moderators only) channel where the real authors of anonymous messages are logged.
# Without this channel, the bot refuses to send anonymous messages.
# (Right-click the channel > Copy Channel ID — enable Developer Mode in Discord first)
LOG_CHANNEL_ID=

###########################################################
# Bot configuration (optional)
###########################################################

# Text displayed above and below each anonymous message (empty = no frame)
# Wrap the value in quotes if it contains spaces or a #.
FRAME=

# Channels where anonymous commands are allowed, comma-separated (empty = all channels)
RESTRICTED_CHANNELS=

# Channels where every message is automatically made anonymous, comma-separated
AUTOMASK_CHANNELS=

# Accent color of log messages (hexadecimal)
EMBED_COLOR=#5906DA

# How long (in days) the anonymous message -> real author mapping is kept.
# 0 = keep forever.
MESSAGE_RETENTION_DAYS=0

# Automatically register slash commands with Discord on every start
DEPLOY_COMMANDS_ON_START=true

###########################################################
# Without Docker (pm2 / node) only
# Under Docker these values are enforced by docker-compose.yml
###########################################################

# SQLite database and log folders (relative to the project root)
# DATA_DIR=data
# LOG_DIR=logs
# HTTP port of the GET /health endpoint (empty = disabled)
# HEALTH_PORT=

###########################################################
# Docker only
###########################################################

# Image to use (e.g. ghcr.io/<owner>/<repo>:latest or registry.gitlab.com/<group>/<project>:latest)
# Leave empty to build the image locally.
# BOT_IMAGE=
TZ=Europe/Paris
